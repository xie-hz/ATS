# ============================================================================
# ATS + EasyMeeting 生产环境变量模板
# 用法: cp .env.example .env 然后逐项修改，尤其是带 <CHANGE ME> 的项
# ============================================================================

# ---------- 基础 ----------
# 环境: local / staging / production
ENVIRONMENT=production
PROJECT_NAME=ATS

# 面试邮件中的 ATS 门户链接（对外的 ATS 前端地址）
FRONTEND_HOST=http://localhost
# 前端构建时注入的后端地址（浏览器可达）
VITE_API_URL=http://localhost:8000

# 后端跨域允许来源（填 ATS 前端的地址，逗号分隔；FRONTEND_HOST 会自动加入）
# 有域名时改为如: https://ats.example.com
BACKEND_CORS_ORIGINS="http://localhost"

# ---------- 安全（务必修改）----------
# JWT 签名密钥: openssl rand -hex 32
SECRET_KEY=<CHANGE ME>
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=<CHANGE ME>

# Sentry 异常监控（可选）
SENTRY_DSN=

# ---------- 邮件（SMTP，用于通知候选人/面试官）----------
SMTP_HOST=smtp.qq.com
SMTP_USER=xxx@qq.com
SMTP_PASSWORD=<授权码>
EMAILS_FROM_EMAIL=xxx@qq.com
SMTP_TLS=False
SMTP_SSL=True
SMTP_PORT=465

# ---------- PostgreSQL（ATS）----------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE ME>

# ---------- MySQL（EasyMeeting）----------
MYSQL_ROOT_PASSWORD=<CHANGE ME>

# ---------- MinIO（简历对象存储，STORAGE_BACKEND=minio 时启用）----------
# local = 存容器内 uploads 卷；生产建议 minio
STORAGE_BACKEND=minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<CHANGE ME>
MINIO_BUCKET=ats

# ---------- EasyMeeting 集成 ----------
# 开放接口 API Key（ATS 与 EasyMeeting 双方必须一致）
EASYMEETING_API_KEY=<CHANGE ME>
# ATS 主持人账号（EasyMeeting 侧按邮箱解析，回退到此默认值）
EASYMEETING_HOST_USER_ID=HR_DEFAULT
# 面试邮件里的入会链接（对外的 EasyMeeting Web 客户端地址）
EASYMEETING_WEB_URL=http://localhost:8080
# EasyMeeting Java 允许的浏览器来源（逗号分隔，与 EASYMEETING_WEB_URL 对应）
EASYMEETING_WEB_CORS_ORIGINS=http://localhost:8080
# EasyMeeting 超级管理员邮箱（逗号分隔）
EM_ADMIN_EMAILS=admin@qq.com
# EasyMeeting 日志级别（debug/info/warn/error）
EM_LOG_LEVEL=info

# ---------- WebRTC ICE ----------
VITE_STUN_URL=stun:stun.l.google.com:19302
# 生产建议启用 TURN（与 easymeeting/turnserver.conf 的 user/pass 一致）:
# VITE_TURN_URL=turn:easymeeting:easyturn2026@<服务器公网IP>:3478
VITE_TURN_URL=
